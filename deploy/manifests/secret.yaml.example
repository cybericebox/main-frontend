# Warm-up flag for the landing challenge (format ICE{…}). The entrypoint derives
# the hash and hint file from it at start; unset → the warm-up stays disabled.
# Not applied with the directory (keeps a real secret from being overwritten by an
# empty one). Copy to secret.yaml locally with the value, or create it directly:
#   kubectl -n cybericebox create secret generic main-frontend-secret --from-literal=WARMUP_FLAG='ICE{…}'
apiVersion: v1
kind: Secret
metadata:
  name: main-frontend-secret
  namespace: cybericebox
type: Opaque
stringData:
  WARMUP_FLAG: ""
