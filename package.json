{
  "name": "main-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "predev": "node scripts/warmup.mjs",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/warmup.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:e2e:static": "NEXT_PUBLIC_WARMUP_FLAG='ICE{e2e_warmup}' npm run build && E2E_STATIC=1 playwright test",
    "pretypecheck": "node scripts/warmup.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@next/third-parties": "16.3.6",
    "@radix-ui/react-popover": "^1.1.23",
    "geist": "^1.7.2",
    "isomorphic-dompurify": "^4.4.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.20.8",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6",
    "typescript-eslint": "^8.70.1"
  }
}
