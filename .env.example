# Template for local dev (.env.local). Every value is required except analytics; no defaults in code.
NEXT_PUBLIC_MAIN_HOST=example.com
NEXT_PUBLIC_API_HOST=api.example.com
NEXT_PUBLIC_ID_HOST=id.example.com
NEXT_PUBLIC_ADMIN_HOST=admin.example.com
NEXT_PUBLIC_EXERCISES_HOST=exercises.example.com
NEXT_PUBLIC_EVENT_DOMAIN=example.com
NEXT_PUBLIC_COOKIE_DOMAIN=example.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@example.com
NEXT_PUBLIC_SECURITY_EMAIL=security@example.com
NEXT_PUBLIC_SOURCE_URL=https://github.com/cybericebox
NEXT_PUBLIC_PARTNER_ICE_NURE_URL=https://ice.nure.ua/ua/
NEXT_PUBLIC_PARTNER_NURE_URL=https://nure.ua
# Optional
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
DEV_ALLOWED_ORIGINS=
# Container listeners (nginx image only, runtime env, see README "Listeners and TLS"). All optional.
# HTTP_PORT=3000
# HTTPS_PORT=8443
# TLS_CERT_FILE=/tls/tls.crt
# TLS_KEY_FILE=/tls/tls.key
# TLS_MIN_VERSION=1.2
# TLS_CLIENT_CA_FILE=/ca/ca.crt
# TLS_CLIENT_AUTH=off
# HEALTH_PORT=
# TLS_RELOAD_INTERVAL=60
